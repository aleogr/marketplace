package web

// Layout is the shell every page is served in.
//
// The description tag, og:description and twitter:description all take one
// field, already cut to length. Three fields would describe the page three
// ways and drift apart without anybody noticing (docs/requirements.md,
// section 7.2).
//
// Three things here are not decoration. The `lang` attribute tells a reader's
// browser and a screen reader which language the text is in. The `hreflang`
// links tell a search engine that these pages are each other's translations,
// which is what keeps two languages from competing as duplicates
// (docs/design.md, decision 10). And the style carries the nonce of this one
// response, so the Content Security Policy can refuse every other script and
// style on the page (docs/roadmap.md, F7).
templ Layout(page Page, title string) {
	<!DOCTYPE html>
	<html lang={ page.Language }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<meta name="description" content={ page.Description }/>
			<meta property="og:type" content="website"/>
			<meta property="og:site_name" content={ page.Title() }/>
			<meta property="og:title" content={ title }/>
			<meta property="og:description" content={ page.Description }/>
			<meta property="og:url" content={ page.URL }/>
			<meta property="og:image" content={ page.Image }/>
			<meta property="og:locale" content={ page.Language }/>
			<meta name="twitter:card" content="summary_large_image"/>
			<meta name="twitter:title" content={ title }/>
			<meta name="twitter:description" content={ page.Description }/>
			<meta name="twitter:image" content={ page.Image }/>
			for tag, address := range page.Alternates {
				<link rel="alternate" hreflang={ tag } href={ address }/>
			}
			<link rel="alternate" hreflang="x-default" href={ page.Default }/>
			<style nonce={ page.Nonce }>
				:root { color-scheme: light dark; }
				body {
					font-family: system-ui, sans-serif;
					line-height: 1.5;
					margin: 0 auto;
					max-width: 40rem;
					padding: 2rem 1rem;
				}
				header { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
				nav form { display: inline; }
				nav button {
					background: none;
					border: 0;
					border-radius: 0.25rem;
					cursor: pointer;
					font: inherit;
					padding: 0.25rem;
					text-decoration: underline;
				}
				nav button[aria-current="true"] { font-weight: 600; text-decoration: none; }
				/* Colours for both schemes, each pair at least 4.5:1 for text
				   and 3:1 for a border (WCAG 2.2 AA). */
				:root {
					--error-text: #8b1a1a; --error-bg: #fdeceb; --error-edge: #c0392b;
					--done-text: #14532d; --done-bg: #e7f6ec; --done-edge: #1f8a4c;
					--action-text: #ffffff; --action-bg: #1d4ed8;
					--action-hover: #1e40af; --action-pressed: #1e3a8a;
					--field-edge: #6b7280; --pressed-tint: rgb(0 0 0 / 0.1); --pressed-tint-strong: rgb(0 0 0 / 0.22);
				}
				@media (prefers-color-scheme: dark) {
					:root {
						--error-text: #ffb4ab; --error-bg: #3a1414; --error-edge: #ff6b5e;
						--done-text: #a7f3c1; --done-bg: #0f2a1a; --done-edge: #3fbf73;
						--action-text: #0b1633; --action-bg: #8fb0ff;
						--action-hover: #a9c2ff; --action-pressed: #c7d7ff;
						--field-edge: #9ca3af; --pressed-tint: rgb(255 255 255 / 0.15); --pressed-tint-strong: rgb(255 255 255 / 0.32);
					}
				}
				/* A refusal must not read as one more hint: a colour, a bar
				   and a mark, so it holds without colour too. The mark is
				   hidden from screen readers, which announce the alert. */
				[role="alert"], [role="status"] {
					border-inline-start: 0.25rem solid;
					border-radius: 0.25rem;
					padding: 0.75rem 1rem;
				}
				[role="alert"] {
					background: var(--error-bg);
					border-color: var(--error-edge);
					color: var(--error-text);
					font-weight: 600;
				}
				[role="alert"]::before { content: "\26A0\FE0E\00A0"; content: "\26A0\FE0E\00A0" / ""; }
				[role="status"] {
					background: var(--done-bg);
					border-color: var(--done-edge);
					color: var(--done-text);
				}
				[role="status"]::before { content: "\2713\00A0"; content: "\2713\00A0" / ""; }
				/* A form reads as one: each label on its own line, above its
				   field. */
				main form label { display: block; margin-top: 1rem; }
				main form input:not([type="hidden"]) {
					border: 1px solid var(--field-edge);
					border-radius: 0.375rem;
					box-sizing: border-box;
					display: block;
					font: inherit;
					margin-top: 0.25rem;
					max-width: 24rem;
					padding: 0.5rem;
					width: 100%;
				}
				main form input[aria-invalid="true"] {
					border-color: var(--error-edge);
					box-shadow: 0 0 0 1px var(--error-edge);
				}
				main form input[aria-invalid="true"]:focus-visible { outline: 2px solid var(--error-edge); outline-offset: 2px; }
				#password-hint { font-size: 0.875rem; margin: 0.25rem 0 0; }
				main form button[type="submit"] {
					background: var(--action-bg);
					border: 1px solid var(--action-bg);
					border-radius: 0.375rem;
					color: var(--action-text);
					cursor: pointer;
					font: inherit;
					font-weight: 600;
					margin-top: 1.25rem;
					padding: 0.5rem 1.25rem;
				}
				main form button[type="submit"]:hover { background: var(--action-hover); }
				main form button[type="submit"]:focus-visible { outline: 2px solid var(--action-bg); outline-offset: 2px; }
				main form button[type="submit"]:active { background: var(--action-pressed); }
				nav button:active { background: var(--pressed-tint); }
				/* A pressed control must say so at once, whatever the
				   connection is doing (docs/requirements.md, section 3). With
				   less motion asked for, the colour above still says it. */
				button[type="submit"]:active { transform: scale(0.97); }
				@media (prefers-reduced-motion: reduce) {
					button[type="submit"]:active { transform: none; }
				}
				/* The security page (F14): one second factor per row, its
				   removal beside it, as a quieter button than a form's own
				   submit. */
				.hint { font-size: 0.875rem; margin: 0.25rem 0 0; }
				ul.factors { list-style: none; padding: 0; }
				ul.factors li {
					border: 1px solid var(--field-edge);
					border-radius: 0.375rem;
					display: flex;
					flex-wrap: wrap;
					gap: 0.25rem 1rem;
					align-items: baseline;
					margin-top: 0.75rem;
					padding: 0.75rem 1rem;
				}
				ul.factors li form { margin-inline-start: auto; }
				main form button[type="submit"].secondary {
					background: transparent;
					border-color: var(--field-edge);
					color: inherit;
					margin-top: 0;
				}
				main form button[type="submit"].secondary:hover { background: var(--pressed-tint); }
				main form button[type="submit"].secondary:active { background: var(--pressed-tint-strong); }
				img.qr { background: #ffffff; display: block; image-rendering: pixelated; margin: 1rem 0; padding: 0.5rem; }
				code.key, ol.codes { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
				code.key { font-size: 1.125rem; word-spacing: 0.25rem; }
				ol.codes { columns: 2; font-size: 1.125rem; }
				footer { color: GrayText; font-size: 0.875rem; margin-top: 3rem; }
			</style>
		</head>
		<body>
			<header>
				<strong>{ page.Title() }</strong>
				@LanguageSwitch(page)
				if page.Accounts {
					@AccountNav(page)
				}
			</header>
			<main>
				{ children... }
			</main>
			<footer>
				<p>{ page.Year() } — { page.Title() }</p>
			</footer>
		</body>
	</html>
}

// LanguageSwitch is the manual choice every page carries.
//
// It posts rather than links, because it changes something that is remembered:
// the cookie that outranks country detection on every later visit. The
// hreflang links above are what a crawler follows; this is what a person uses
// (docs/requirements.md, section 6).
templ LanguageSwitch(page Page) {
	<nav aria-label={ page.T("language.switch") }>
		for _, tag := range page.Languages() {
			<form method="post" action="/language">
				<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
				<input type="hidden" name="language" value={ tag }/>
				<input type="hidden" name="path" value={ page.Path }/>
				<button
					type="submit"
					lang={ tag }
					if tag == page.Language {
						aria-current="true"
					}
				>{ page.Name(tag) }</button>
			</form>
		}
	</nav>
}

// AccountNav is who is signed in, where there are accounts: the name, the way
// out and the password page, or the two ways in. The platform's own pages, a
// marketplace still in preparation and a process with no identity routes have
// none, and carry none (Page.Accounts).
templ AccountNav(page Page) {
	<nav class="account" aria-label={ page.T("identity.header.account") }>
		if page.Account != "" {
			<span>{ page.T("identity.header.signed_in_as", page.Account) }</span>
			<form method="post" action={ templ.SafeURL("/" + page.Language + "/signout") }>
				<input type="hidden" name="csrf_token" value={ page.CSRFToken }/>
				<button type="submit">{ page.T("identity.signout.submit") }</button>
			</form>
			<a href={ templ.SafeURL("/" + page.Language + "/account/password") }>{ page.T("identity.header.password") }</a>
			<a href={ templ.SafeURL("/" + page.Language + "/account/security") }>{ page.T("identity.header.security") }</a>
		} else {
			<a href={ templ.SafeURL("/" + page.Language + "/signin") }>{ page.T("identity.link.signin") }</a>
			<a href={ templ.SafeURL("/" + page.Language + "/signup") }>{ page.T("identity.link.signup") }</a>
		}
	</nav>
}
